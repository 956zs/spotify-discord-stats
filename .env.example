# Discord bot/app
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_USER_ID=
DISCORD_IDENTITY_ID=0
DISCORD_REMINDER_USER_ID=

# Spotify OAuth app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://your-domain.example/spotify/callback
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REFRESH_TOKEN_ISSUED_AT=
SPOTIFY_REFRESH_TOKEN_VALID_DAYS=180
SPOTIFY_REAUTH_REMIND_DAYS=30

# Built-in OAuth callback server.
# Put this behind your VPS domain/reverse proxy and add the callback URL above
# to the Spotify developer dashboard.
PUBLIC_BASE_URL=https://your-domain.example
AUTH_SERVER_HOST=0.0.0.0
AUTH_SERVER_PORT=23189

# Runtime
DATABASE_PATH=./data/spotify.sqlite
SYNC_INTERVAL_SECONDS=900
REAUTH_REMINDER_INTERVAL_HOURS=24
SPOTIFY_STATS_DAYS=28
PATCH_DISCORD_ON_SYNC=true
PATCH_ONLY_WHEN_CHANGED=true

# Discord widget payload
WIDGET_USERNAME=My Spotify Stats
WIDGET_MAIN_TITLE=Last 4 Weeks Played:
WIDGET_FIELD_MAIN_TITLE=main_title
WIDGET_FIELD_SONGS_PLAYED=Songs_Played
WIDGET_FIELD_LISTENING_TIME=Listening_Time
WIDGET_FIELD_UNIQUE_SONGS=Unique_Songs
WIDGET_FIELD_DIFFERENT_ARTISTS=Different_Artists
WIDGET_FIELD_DIFFERENT_ALBUMS=Different_Albums
WIDGET_FIELD_MOST_LISTENED_GENRE=Most_Listened_Genre
WIDGET_FIELD_LAST_UPDATED=last_updated
