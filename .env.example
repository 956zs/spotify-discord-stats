# Discord bot/app
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_USER_ID=
DISCORD_REMINDER_USER_ID=

# Spotify OAuth app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://stats.example.com/spotify/callback
SPOTIFY_REFRESH_TOKEN=

# Built-in OAuth callback server.
# Put this behind your VPS domain/reverse proxy and add the callback URL above
# to the Spotify developer dashboard.
PUBLIC_BASE_URL=https://stats.example.com
AUTH_SERVER_HOST=0.0.0.0
AUTH_SERVER_PORT=23189

# Runtime
DATABASE_PATH=./data/spotify.sqlite
